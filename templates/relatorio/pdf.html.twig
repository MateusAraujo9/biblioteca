<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: "DejaVu Sans", sans-serif; font-size: 10px; color: #222; }
        h1 { font-size: 16px; margin-bottom: 2px; }
        .emissao { color: #666; margin-bottom: 12px; }
        h2 { font-size: 12px; background: #0d6efd; color: #fff; padding: 4px 6px; margin: 14px 0 0; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 3px 5px; text-align: left; }
        th { background: #f0f0f0; }
        .valor { text-align: right; }
        .subtotal td { font-weight: bold; background: #fafafa; }
    </style>
</head>
<body>
    <h1>Relatório de livros por autor</h1>
    <div class="emissao">Emitido em {{ 'now'|date('d/m/Y H:i', 'America/Sao_Paulo') }}</div>

    {% for grupo in grupos %}
        <h2>{{ grupo.autor }}</h2>
        <table>
            <tr>
                <th>Título</th>
                <th>Editora</th>
                <th>Edição</th>
                <th>Ano</th>
                <th>Assuntos</th>
                <th>Autores</th>
                <th class="valor">Valor</th>
            </tr>
            {% for livro in grupo.livros %}
                <tr>
                    <td>{{ livro.Titulo }}</td>
                    <td>{{ livro.Editora }}</td>
                    <td>{{ livro.Edicao }}</td>
                    <td>{{ livro.AnoPublicacao }}</td>
                    <td>{{ livro.assuntos }}</td>
                    <td>{{ livro.autores }}</td>
                    <td class="valor">{{ livro.Valor|format_currency('BRL') }}</td>
                </tr>
            {% endfor %}
            <tr class="subtotal">
                <td colspan="6">{{ grupo.livros|length }} livro(s)</td>
                <td class="valor">{{ grupo.livros|reduce((total, l) => total + l.Valor, 0)|format_currency('BRL') }}</td>
            </tr>
        </table>
    {% else %}
        <p>Nenhum livro cadastrado.</p>
    {% endfor %}
</body>
</html>