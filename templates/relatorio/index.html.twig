{% extends 'base.html.twig' %}

{% block title %}Relatório{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="page-title mb-0">Relatório de livros por autor</h1>
        <a href="{{ path('app_relatorio_pdf') }}" class="btn btn-primary" target="_blank">Baixar PDF</a>
    </div>

    {% for grupo in grupos %}
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <h2 class="h5 mb-0">{{ grupo.autor }}</h2>
                <span class="text-muted">
                    {{ grupo.livros|length }} livro(s) ·
                    {{ grupo.livros|reduce((total, l) => total + l.Valor, 0)|format_currency('BRL') }}
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Editora</th>
                            <th>Edição</th>
                            <th>Ano</th>
                            <th>Assuntos</th>
                            <th>Autores</th>
                            <th class="text-end">Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for livro in grupo.livros %}
                        <tr>
                            <td>{{ livro.Titulo }}</td>
                            <td>{{ livro.Editora }}</td>
                            <td>{{ livro.Edicao }}</td>
                            <td>{{ livro.AnoPublicacao }}</td>
                            <td>{{ livro.assuntos }}</td>
                            <td>{{ livro.autores }}</td>
                            <td class="text-end">{{ livro.Valor|format_currency('BRL') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">Nenhum livro cadastrado.</div>
    {% endfor %}
{% endblock %}