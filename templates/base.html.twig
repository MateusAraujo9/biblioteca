<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Biblioteca{% endblock %}</title>

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% set rota = app.request.attributes.get('_route') %}
        <nav class="navbar navbar-expand-lg navbar-dark bg-prtimary-custom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold" href="{{ path('app_home') }}">Biblioteca</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <div class="navbar-nav ms-auto">
                        <a class="nav-link {{rota starts with 'app_livro' ? 'active' : ''}}" href="{{ path('app_livro_index') }}">Livros</a>
                        <a class="nav-link {{rota starts with 'app_autor' ? 'active' : ''}}" href="{{ path('app_autor_index') }}">Autores</a>
                        <a class="nav-link {{rota starts with 'app_assunto' ? 'active' : ''}}" href="{{ path('app_assunto_index') }}">Assuntos</a>
                        <a class="nav-link {{ rota starts with 'app_relatorio' ? 'active' : '' }}" href="{{ path('app_relatorio_index') }}">Relatório</a>
                    </div>
                </div>
            </div>
        </nav>

        <main class="container py-4">
            {% for tipo, mensagens in app.flashes %}
                {% for mensagem in mensagens %}
                    <div class="alert alert-{{ tipo == 'error' ? 'danger' : tipo }} alert-dismissible fade show">
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        {{ mensagem }}
                    </div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
