<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Biblioteca{% endblock %}</title>

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">Biblioteca</a>
                <div class="navbar-nav">
                    <a class="nav-link" href="{{ path('app_livro_index') }}">Livros</a>
                    <a class="nav-link" href="{{ path('app_autor_index') }}">Autores</a>
                    <a class="nav-link" href="{{ path('app_assunto_index') }}">Assuntos</a>
                </div>
            </div>
        </nav>

        <main class="container">
            {% for tipo, mensagens in app.flashes %}
                {% for mensagem in mensagens %}
                    <div class="alert alert-{{ tipo == 'error' ? 'danger' : tipo }}">
                        {{ mensagem }}
                    </div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
