{% extends 'base.html.twig' %}

{% block title %}Autores{% endblock %}

{% block body %}
    <h1>Autores</h1>
    <a href="{{ path('app_autor_new') }}" class="btn btn-primary">Novo Autor</a>

    <table class="table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nome</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        {% for autor in autores %}
            <tr>
                <td>{{ autor.codAu }}</td>
                <td>{{ autor.nome }}</td>
                <td>
                    <a href="{{ path('app_autor_edit', {'id': autor.codAu}) }}" class="btn btn-outline-warning btn-sm">
                        Editar
                    </a>

                    <form method="post" action="{{ path('app_autor_delete', {'id': autor.codAu}) }}" style="display:inline-block;" onsubmit="return confirm('Tem certeza que deseja excluir este autor?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ autor.codAu) }}">
                        <button class="btn btn-outline-danger btn-sm">Excluir</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Nenhum autor encontrado</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}